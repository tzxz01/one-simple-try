total = []

# 添加任务
def add_task(title):
    total.append({'title': title, 'done': False})
    print('已添加', title)

# 查看任务    
def list_tasks():
    if not total:
        print('暂无任务')
        return
    for i, task in enumerate(total, 1):
        if task['done']:
            status = 'yes'
        else:
            status = 'no'
        print(i, task['title'], status)

# 标记任务完成            
def mark_done(t_num):
    index=t_num-1
    if 0 <= index < len(total):
        total[index]['done'] = True
        print('已完成', total[index]['title'])
    else:
        print('无效的序号')

# 删除任务      
def delete_task(t_num):
    index=t_num-1
    if 0 <= index < len(total):
        removed = total.pop(index)
        print('已删除', removed['title'])
    else:
        print('无效的序号')

#修改任务        
def edit_task(t_num):
    index=t_num-1
    if 0 <=index <len(total):
        new_ttl=input('输入新的任务内容:')
        total[index]['title']=new_ttl
        print(index+1,new_ttl)        

while True:
    print('\n=====待办事项=====')
    print('1.添加任务')
    print('2.查看任务')
    print("3.标记完成")
    print("4.删除任务")
    print("5.编辑任务")
    print("6.退出")
    
    choice = input('请选择操作：')
    
    if choice == '1':
        title = input('输入任务内容：')
        add_task(title)  
        
    elif choice == '2':
        list_tasks()   
    
    elif choice == '3':
        list_tasks()
        t_num = int(input('输入要标记完成的任务:'))
        mark_done(t_num)
    
    elif choice == '4':
        list_tasks()
        t_num = int(input('输入要删除的任务:')) 
        delete_task(t_num)
    
    elif choice == '5':
        list_tasks()
        t_num = int(input('输入要编辑的任务:')) 
        edit_task(t_num)
    
    elif choice == '6':
        print('再见')
        break
    
    else:
        print('无效选择')